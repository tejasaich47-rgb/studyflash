# Copy to .env and fill in. Any OpenAI-compatible chat-completions endpoint works.

# --- Groq (free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-key-here

# --- Gemini (free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-key-here

# --- Ollama (local, no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Ask the provider for JSON mode. Set to 0 if your provider rejects response_format.
LLM_JSON_MODE=1

# Try the UI with no API key at all (canned deck + failure simulations).
# LLM_MOCK=1

PORT=8787
